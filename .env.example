APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The address the site is opened at (`php artisan serve` — port 8000): WordPress's
# home and siteurl and the themes' demos take their links from it.
# In quotes: `laravel new` rewrites an unquoted http://localhost here, some versions into :8000:8000.
APP_URL="http://localhost:8000"
# TRUSTED_PROXIES=*

# Vue and React pages are rendered by `php artisan inertia:start-ssr` once the themes are built; the port is this URL's.
# INERTIA_SSR_URL=http://127.0.0.1:13714

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_PREFIX=wp_

# The administrator `php artisan db:seed` creates; set both before seeding a site
# that is not on your own machine.
# SEED_ADMIN_EMAIL=admin@kitloom.test
# SEED_ADMIN_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
